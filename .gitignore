# Built portal (make docs-build). The leading slash matters: tools/site/ is source.
/site/

# Zensical build cache
/.cache/

# Generated by tools/site/releases.py: the configuration given to Zensical for
# each site and for the root site, and the sources of the root site
/.zensical.*.toml
/.build/

# Local virtual environment (python3 -m venv .venv)
/.venv/

# Python bytecode
__pycache__/

# Generated by tools/site/prebuild.py, one per site: docs/<module>/ or
# docs/<module>/<release>/
/docs/*/assets/data/updates.json
/docs/*/assets/data/glossary.json
/docs/*/*/assets/data/updates.json
/docs/*/*/assets/data/glossary.json

# Downloaded by tools/site/fetch_vendor.py (make docs-deps)
/overrides/assets/vendor/mermaid/mermaid.min.js

# Quick lab (docs/lab/): the settings and state of a lab run from a checkout.
docs/lab/variants/*/config.env
docs/lab/variants/*/.state/

# Checkout of the OzarLand hub made by CI for tools/site/check_content.py.
.ozarland-hub/
