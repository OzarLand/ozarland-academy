# Lab settings. Copy to lab.env at the repository root and adapt.
# lab.env is ignored by Git. It must not contain credentials: cloud
# credentials stay in your OpenStack client configuration, and service
# passwords are generated inside the cluster.
# shellcheck shell=bash disable=SC2034

# --- Cluster identity -------------------------------------------------------
# The cluster answers on api.<CLUSTER_NAME>.<BASE_DOMAIN> and
# *.apps.<CLUSTER_NAME>.<BASE_DOMAIN>. These names are only resolvable through
# the bastion DNS, so any domain you control (or a reserved one) works.
CLUSTER_NAME=okd
BASE_DOMAIN=lab.example.com
# Host name of the single OKD node.
OKD_NODE_NAME=okd-0

# --- Access -----------------------------------------------------------------
# Private key used from the workstation to reach the bastion. Its public
# half is the ssh_public_key_file given to Terraform.
SSH_PRIVATE_KEY_FILE=~/.ssh/id_ed25519
# Login user of the bastion image (cloud-user on CentOS Stream).
BASTION_USER=cloud-user
# Terraform-compatible command used by the workstation scripts.
TERRAFORM=terraform

# --- Versions (see docs/versions.md for what was validated together) --------
OKD_VERSION=4.22.0-okd-scos.10
CERT_MANAGER_VERSION=v1.21.3
METALLB_VERSION=v0.16.2
# Only its FRRConfiguration CRD is installed (scripts/bastion/04-platform-services.sh).
# Use the frr-k8s version the MetalLB release pairs with.
FRR_K8S_VERSION=v0.0.27
# Only its BareMetalHost CRD is installed (scripts/bastion/05-openstack-operators.sh).
BAREMETAL_OPERATOR_VERSION=v0.14.2
# Operator catalog image. Pin it to a digest once you have a working lab so
# that a rebuild installs exactly the same operators.
OPENSTACK_OPERATOR_INDEX=quay.io/openstack-k8s-operators/openstack-operator-index:18-stable-latest
OPENSTACK_OPERATOR_CHANNEL=alpha

# --- OpenStack --------------------------------------------------------------
# Number and size of the local persistent volumes created on the OKD node.
STORAGE_PV_COUNT=12
STORAGE_PV_SIZE=10Gi
# Hypervisor type on compute nodes: kvm, qemu, or auto (kvm when the compute
# VM exposes hardware virtualization, qemu otherwise).
COMPUTE_VIRT_TYPE=auto

# --- Time synchronisation ---------------------------------------------------
# NTP server used by the OKD node and the compute nodes.
NTP_SERVER=pool.ntp.org
# Set to true when the lab VMs cannot reach any NTP server: the bastion then
# serves its clock to the lab and NTP_SERVER is ignored. If the bastion itself
# has no time source either, the nodes still agree with each other, which is
# what the cluster needs; check the bastion clock from time to time.
BASTION_NTP_SERVER=false

# --- Outbound access (see docs/installation/README.md) ----------------------
# HTTP proxy for clouds where lab VMs have no direct Internet access, for
# example http://proxy.example.com:3128. Leave empty for direct access.
HTTP_PROXY_URL=
# Extra destinations that must bypass the proxy (comma-separated host names,
# domains or CIDRs). Lab networks and cluster names are excluded automatically.
NO_PROXY_EXTRA=

# --- Host cloud particularities ---------------------------------------------
# Set to true if the image service refuses the installer ISO (some reject
# "hybrid" ISO files, which also carry a disk partition table). The first
# 32 KiB of the uploaded copy are then blanked; it still boots as a CD-ROM.
ISO_BLANK_SYSTEM_AREA=false
